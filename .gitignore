# Private development notes — never shared (incl. dev/papers, dev/references, dev/research)
/dev/

# Datasets: keep the folder structure + any docs, never the data files
# (datasets are large and/or sensitive; share documentation, not data).
/data/**
!/data/**/
!/data/**/*.md

# Per-run training artifacts (regeneratable). The curated record lives under
# examples/<topic>/results/ instead (committed: figures, metric tables, README).
/output/
/runs/

# Model checkpoints / large binaries
*.pt
*.pth
*.ckpt

# Auto-generated SkyPilot task specs (keep the dir placeholder)
/ops/configs/skypilot/generated/*
!/ops/configs/skypilot/generated/.gitkeep

# Python / tooling / OS
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.env
.venv/
build/
dist/

# mkdocs build output
/site/

# mkdocs build output (regeneratable; the site is published via GitHub Actions)
/site/
